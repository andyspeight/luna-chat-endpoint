# Supabase Postgres connection string for the "Travelgenix CRM" project.
# Use the POOLER / transaction-mode string (port 6543) with the service/postgres role.
# The backoffice + contracts schemas are NOT exposed to PostgREST, so we connect
# directly to Postgres server-side (same approach as contract-loader).
#
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction pooler".
DATABASE_URL=postgresql://postgres.iexryjynfaktfbvzlwlx:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
