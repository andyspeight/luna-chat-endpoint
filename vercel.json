{
  "version": 2,
  "functions": {
    "api/luna-chat.js": { "maxDuration": 30, "memory": 256 },
    "api/widget.js": { "maxDuration": 5, "memory": 128 },
    "api/clients.js": { "maxDuration": 10, "memory": 128 },
    "api/profile.js": { "maxDuration": 10, "memory": 128 },
    "api/auth.js": { "maxDuration": 10, "memory": 128 },
    "api/widget-config.js": { "maxDuration": 10, "memory": 128 },
    "api/ably-token.js": { "maxDuration": 5, "memory": 128 },
    "api/monitor.js": { "maxDuration": 15, "memory": 128 },
    "api/knowledge-freshness.js": { "maxDuration": 30, "memory": 128 },
    "api/fcdo.js": { "maxDuration": 15, "memory": 128 },
    "api/discover-scan.js": { "maxDuration": 60, "memory": 256 },
    "api/global-brain.js": { "maxDuration": 15, "memory": 128 },
    "api/reverify.js": { "maxDuration": 60, "memory": 256 },
    "api/reverify-structured.js": { "maxDuration": 60, "memory": 256 },
    "api/refresh-fcdo.js": { "maxDuration": 60, "memory": 256 },
    "api/whatsapp-webhook.js": { "maxDuration": 30, "memory": 256 },
    "api/whatsapp-send.js": { "maxDuration": 15, "memory": 128 },
    "api/agent-reply-check.js": { "maxDuration": 10, "memory": 128 }
  },
  "crons": [
    { "path": "/api/monitor", "schedule": "*/15 * * * *" },
    { "path": "/api/knowledge-freshness", "schedule": "0 8 * * *" },
    { "path": "/api/fcdo?warm=1", "schedule": "0 7 * * *" },
    { "path": "/api/discover-scan", "schedule": "0 */3 * * *" },
    { "path": "/api/reverify", "schedule": "0 5 * * *" },
    { "path": "/api/reverify-structured", "schedule": "0 2 * * *" },
    { "path": "/api/refresh-fcdo", "schedule": "0 4 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/onboard.html",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
